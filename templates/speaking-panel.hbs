<ul class="wota-lamps">
  {{#each lamps}}
  <li>
    <button type="button" class="wota-lamp-row{{#if speaking}} speaking{{/if}}" data-action="toggleSpeaking"
      data-shadow-id="{{shadowId}}" aria-pressed="{{#if speaking}}true{{else}}false{{/if}}" {{disabled isDisabled}}>
      <span class="wota-lamp{{#if speaking}} on{{/if}}" aria-hidden="true"></span>
      <span class="wota-lamp-name" data-tooltip="{{name}}">{{name}}</span>
    </button>
  </li>
  {{else}}
  <li class="wota-lamps-empty">{{localize "WOTA.Panel.Empty"}}</li>
  {{/each}}
</ul>
